      <pubDate>Sun, 23 Feb 2025 06:04:35 +0000</pubDate>
      <guid>https://www.frytea.com/archives/1431/</guid>
      <description>&lt;h1 id=&#34;tldr&#34;&gt;TL;DR&lt;/h1&gt;
